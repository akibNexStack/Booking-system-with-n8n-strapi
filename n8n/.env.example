# Generate and keep one stable random value. Changing it makes saved n8n
# credentials unreadable.
N8N_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Public HTTPS address of this n8n instance. Keep the trailing slash.
N8N_PUBLIC_URL=https://n8n.example.com/
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
